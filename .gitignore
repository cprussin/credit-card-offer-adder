result

# Runtime state: browser profiles (contain live bank session cookies) and
# failure artifacts (screenshots / HTML dumps from a bank page). Neither may
# ever be committed.
.profiles/
.artifacts/

# The local account configuration names real accounts and mailboxes.
offers.config.json

# The credentials document: four bank logins, their TOTP secrets, a mailbox
# password. Never committed, sealed or not. The `.example` file is the only
# one tracked.
offers.credentials.json
*.cred

# Generated at build time via IFD (see nix/offer-adder.nix); never committed.
bun.generated.nix
