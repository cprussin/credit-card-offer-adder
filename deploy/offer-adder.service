[Unit]
Description=Add every available card offer to the configured Amex and Chase accounts
Documentation=https://github.com/cprussin/credit-card-offer-adder
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/credit-card-offer-adder

# The credentials document — the four bank logins, their TOTP secrets, the
# mailbox login and the ntfy token — sealed to this machine. Seal it once with
#
#   systemd-creds encrypt --user --with-key=host+tpm2 \
#       --name=offers-credentials \
#       credentials.json %h/.config/offer-adder/credentials.cred
#   shred -u credentials.json
#
# systemd decrypts it at start into $CREDENTIALS_DIRECTORY, a tmpfs private to
# this unit and readable only by this user, and unmounts it when the run ends.
# The plaintext therefore never sits on disk and never shows up in
# `systemctl show`. The app looks there by name, so nothing below has to point
# at it.
#
# Without a TPM, drop --with-key=host+tpm2 down to --with-key=host. To skip
# sealing entirely, DELETE the LoadCredentialEncrypted line below and add
#
#   Environment=OFFERS_CREDENTIALS=%h/.config/offer-adder/offers.credentials.json
#
# pointing at a mode-600 file — the app refuses to read one that is group- or
# world-readable. Leaving both in place does not do what it looks like:
# CREDENTIALS_DIRECTORY wins and OFFERS_CREDENTIALS is never consulted.
LoadCredentialEncrypted=offers-credentials:%h/.config/offer-adder/credentials.cred

# Non-secret by construction: account ids, labels, issuers, code-source order,
# IMAP host and folder. No password, secret or token belongs in this file.
Environment=OFFERS_CONFIG=%h/.config/offer-adder/offers.config.json

# Xvfb rather than headless Chromium: a headless browser is the easiest thing
# for a bank to fingerprint, and being fingerprinted means a challenge on every
# run. `"headless": false` in the config plus a virtual display is what keeps
# the browser profile trusted, which is what keeps the run unattended.
ExecStart=/usr/bin/xvfb-run --auto-servernum --server-args=-screen\x200\x201440x900x24 \
    %h/.bun/bin/bun apps/offer-adder/src/main.ts

# One run is a few minutes. If it is still going after this, something is hung
# on a bank page and the next firing is a better bet than waiting.
TimeoutStartSec=30min

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
