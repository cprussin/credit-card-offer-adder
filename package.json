{
  "catalog": {
    "@biomejs/biome": "^2.5.7",
    "@cprussin/option-result": "^2.0.1",
    "@cprussin/tsconfig": "^5.0.0",
    "@types/bun": "^1.3.14",
    "@types/mailparser": "^3.4.6",
    "imapflow": "^1.0.194",
    "mailparser": "^3.7.4",
    "playwright": "1.61.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=22"
  },
  "name": "credit-card-offer-adder",
  "packageManager": "bun@1.3.11",
  "private": true,
  "scripts": {
    "build:install-modules": "[ $CI$CLAUDE_CODE_REMOTE ] && true || bun install",
    "fix:lint": "biome check --max-diagnostics=none --write",
    "test:dependencies": "bun outdated -r",
    "test:dependency-min-age": "bun packages/dependency-min-age/src/check.ts",
    "test:lint": "biome check --max-diagnostics=none",
    "turbo": "[ ! -d node_modules ] && bun install --frozen-lockfile; node_modules/.bin/turbo"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
