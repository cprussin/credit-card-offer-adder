{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "CI",
    "CLAUDE_CODE_REMOTE",
    "CREDENTIALS_DIRECTORY",
    "FORCE_COLOR",
    "HOME",
    "OFFERS_CONFIG",
    "OFFERS_CREDENTIALS",
    "PLAYWRIGHT_BROWSERS_PATH",
    "XDG_DATA_HOME",
    "XDG_STATE_HOME"
  ],
  "tasks": {
    "//#build": {
      "dependsOn": ["//#build:install-modules"]
    },
    "//#build:install-modules": {
      "inputs": ["**/package.json", "bunfig.toml", "!**/dist/**"],
      "outputs": ["bun.lock"]
    },

    "//#fix": {
      "with": ["//#fix:lint"]
    },
    "//#fix:lint": {
      "cache": false,
      "dependsOn": ["//#build"]
    },

    "//#test": {
      "with": [
        "//#test:dependencies",
        "//#test:dependency-min-age",
        "//#test:lint"
      ]
    },
    "//#test:dependencies": {
      "cache": false,
      "dependsOn": ["//#build"]
    },
    "//#test:dependency-min-age": {
      "cache": false,
      "dependsOn": ["//#build"]
    },
    "//#test:lint": {
      "dependsOn": ["//#build"]
    },

    "start:offers": {
      "cache": false,
      "dependsOn": ["//#build"],
      "persistent": true
    },

    "test": {
      "with": ["test:types", "test:unit"]
    },
    "test:types": {
      "dependsOn": ["//#build", "^test:types"]
    },
    "test:unit": {
      "dependsOn": ["//#build"]
    }
  },
  "ui": "tui"
}
